{
  "name": "suiweet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "walrus:init": "mkdir -p ~/.config/walrus && curl https://docs.wal.app/setup/client_config.yaml -o ~/.config/walrus/client_config.yaml && curl https://raw.githubusercontent.com/MystenLabs/walrus-sites/refs/heads/mainnet/sites-config.yaml -o ~/.config/walrus/sites-config.yaml",
    "walrus:init:win": "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force -Path $env:USERPROFILE\\.config\\walrus | Out-Null; Invoke-WebRequest -Uri https://docs.wal.app/setup/client_config.yaml -OutFile $env:USERPROFILE\\.config\\walrus\\client_config.yaml; Invoke-WebRequest -Uri https://raw.githubusercontent.com/MystenLabs/walrus-sites/refs/heads/mainnet/sites-config.yaml -OutFile $env:USERPROFILE\\.config\\walrus\\sites-config.yaml\"",
    "deploy:walrus": "npm run build && site-builder --config ./sites-config.yaml deploy ./dist --epochs 10"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^0.19.11",
    "@mysten/enoki": "^0.12.15",
    "@mysten/sui": "^1.45.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.90.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.552.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.5.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
